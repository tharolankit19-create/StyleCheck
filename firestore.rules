rules_version = '2';

// StyleCheck Firestore rules.
//
// Principle: the client reads its own data but NEVER writes score, entitlement,
// or analysis documents. All of those are written exclusively by Cloud
// Functions (admin SDK bypasses these rules). Entitlements are set only by the
// RevenueCat webhook — a user can never grant themselves premium.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profile + entitlements: readable by owner, writable only server-side.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      // Per-user history and quota are server-managed; owner may read history.
      match /history/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /quota/{doc} {
        allow read: if false;
        allow write: if false;
      }
    }

    // Analyses hold the authoritative score/critique and are written by
    // Functions only. Clients receive results via the callable's return value,
    // not by reading this collection.
    match /analyses/{sha} {
      allow read: if false;
      allow write: if false;
    }
  }
}
