rules_version = '2';

// StyleCheck Storage rules.
//
// A signed-in user may upload their own photo under uploads/<uid>/... only, and
// only images under a sane size cap. Generated restyles are written by Cloud
// Functions and read via short-lived signed URLs, so clients don't read them
// directly here.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /uploads/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /restyles/{uid}/{fileName} {
      // Written by Functions (admin) and delivered via signed URL.
      allow read: if false;
      allow write: if false;
    }
  }
}
