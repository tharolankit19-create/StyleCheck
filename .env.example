# ─────────────────────────────────────────────────────────────────────────────
# StyleCheck environment template.
# Copy to `.env` and fill in. `.env` is gitignored. Nothing here is committed.
#
# CLIENT values are public-by-design Firebase config + the RevenueCat *public*
# SDK key. They are injected into the Flutter build via --dart-define (see
# scripts/run_live.sh). They are NOT secrets.
#
# SERVER values are the real secrets. They live ONLY in Firebase Cloud
# Functions (Secret Manager) and are never shipped in the client.
# ─────────────────────────────────────────────────────────────────────────────

# ── CLIENT (Flutter, via --dart-define) ─────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=            # e.g. your-project-id.appspot.com
FIREBASE_AUTH_DOMAIN=              # optional; defaults to <project>.firebaseapp.com
FIREBASE_IOS_BUNDLE_ID=           # e.g. com.yourco.stylecheck (iOS only)

# RevenueCat PUBLIC SDK key — platform specific. Use the Apple key for iOS
# builds and the Google key for Android builds.
REVENUECAT_API_KEY=

# Set to false for real builds; true runs the fully offline demo.
USE_MOCK=false

# ── SERVER (Cloud Functions secrets — set with `firebase functions:secrets:set`)
# Do NOT put these in the client build. Listed here only so you know what to set.
#   REPLICATE_API_TOKEN       -> Replicate API token (image generation)
#   REVENUECAT_WEBHOOK_AUTH   -> shared Authorization header you configure in
#                                RevenueCat → Integrations → Webhooks
#   VISION_API_KEY            -> only needed for LOCAL emulation; deployed
#                                Functions use the service account (ADC)
#
# Non-secret server params (optional overrides via functions params/env):
#   REPLICATE_MODEL           -> default: black-forest-labs/flux-kontext-pro
#   FREE_ANALYSES_PER_DAY     -> default: 3
