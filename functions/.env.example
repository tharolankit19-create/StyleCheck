# Non-secret Cloud Functions runtime config. Copy to functions/.env (gitignored).
# Secrets (REPLICATE_API_TOKEN, REVENUECAT_WEBHOOK_AUTH) are NOT set here — use
# `firebase functions:secrets:set <NAME>` so they live in Secret Manager.

# Enforce Firebase App Check on callables. Set true once App Check is registered.
ENFORCE_APP_CHECK=false

# Free analyses per user per day (non-premium).
FREE_ANALYSES_PER_DAY=3

# Replicate restyle model.
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
